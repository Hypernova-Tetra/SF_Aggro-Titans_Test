Code "Giganto Finale Beta"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
    #import "Services"
    static bool IsConfigInitialised = false;
    static bool scene1Bool = false;
	static int BossGiantFinale = 0;
//
{
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		BossGiantFinale = INI.Parse<int>(ini["Main"]["BossGiant1160"], BossGiantFinale);
        IsConfigInitialised = true;

        if (BossGiantFinale == 1)
        { WriteProtected<byte> (/* 0x141453520 */ ScanSignature( "bo1160", "xxxxxx" ), System.Text.Encoding.UTF8.GetBytes("bo1151")); }
        else
        { scene1Bool = false; }
		
		if (BossGiantFinale == 2)
        { WriteProtected<byte> ( /* 0x141453520 */ ScanSignature ( "bo1160", "xxxxxx" ), System.Text.Encoding.UTF8.GetBytes("bo1170") ); }
        else
        { scene1Bool = false; }
    }
}

Code "Wyvern Finale Beta"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
    #import "Services"
    static bool IsConfigInitialised = false;
    static bool WyvernFinishBool = false;
	static int BossDragonFinal = 0;
//
{
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		BossDragonFinal = INI.Parse<int>(ini["Main"]["BossDragonFinish"], BossDragonFinal);
        IsConfigInitialised = true;

        if (BossDragonFinal == 1)
        { WyvernFinishBool = true; }
        else
        { WyvernFinishBool = false; }
    }
	
	if (!WyvernFinishBool)
		return;
	{ WriteProtected<byte> ( /* 0x14144CA38 */ ScanSignature ( "zev_dragon_finish_01", "xxxxxxxxxxxxxxxxxxxx" ), System.Text.Encoding.UTF8.GetBytes("zev_dragon_finish_00")); }
}

Code "Supreme Intro"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
    #import "Services"
    static bool IsConfigInitialised = false;
    static bool RifleStartBool = false;
	static int RifleStart = 0;
//
{
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		RifleStart = INI.Parse<int>(ini["Main"]["BossRifleStart"], RifleStart);
        IsConfigInitialised = true;

        if (RifleStart == 1)
        { RifleStartBool = true; }
        else
        { RifleStartBool = false; }
    }
	
	if (!RifleStartBool)
		return;
	{ WriteProtected<byte> ( /* 0x1414624B0 */ ScanSignature ( "bo4110", "xxxxxx" ), System.Text.Encoding.UTF8.GetBytes("bo411X")); }
}