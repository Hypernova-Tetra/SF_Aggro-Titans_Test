Code "Supreme Grand Slam Damage" by Nowasu
//
	#include "Reflection" noemit
	#lib "Reflection"
	#lib "Memory"
	#lib "GameObject"
	#lib "GameManager"
	#lib "EventPlayer"
	#import "Services"
	#import "GOComponents"
	static bool Applied = false;
	static int GrandDmgPercent = 10;
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;

	var pRifle = GameManager.GetGameObject("Rifle0");
	if (pRifle == null)
		return;

	bool grandS1 = evtPlayer->IsEventPlaying("zev_rfl_grndsp01");
	bool grandS2 = evtPlayer->IsEventPlaying("zev_rfl_grndsp02");

	if (grandS1 || grandS2)
	{
		// Read the boss's live HP straight from its GOCHealth component:
		// healthPoint at +0x80, maxHealthPoint at +0x84.
		var pHealth = GameObject.GetGOC(pRifle, "GOCHealth");
		if (pHealth == null)
			return;

		int cur = Read<int>((nint)((long)pHealth + 0x80));
		int maxHp = Read<int>((nint)((long)pHealth + 0x84));

		if (!Applied && maxHp > 0 && cur > 0 && cur <= maxHp)
		{
			Applied = true;

			int dmg = (maxHp * GrandDmgPercent) / 100;
			if (dmg < 1) dmg = 1;
			int after = cur - dmg;
			if (after < 0) after = 0;

			WriteProtected<int>((nint)((long)pHealth + 0x80), after);
		}
	}
	else
	{
		Applied = false;
	}
}
