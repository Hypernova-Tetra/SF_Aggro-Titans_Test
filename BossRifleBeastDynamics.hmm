Code "Monologue" by "Hypernova"
//
	#include "Reflection" noemit
    #import "GOComponents"
    #import "PlayerVisuals"
	#import "Services"
	#import "Graphics"
	#import "Plugins"
    #lib "Reflection"
	#lib "HMM"
	#lib "INI"
	using System.Numerics;
    using System.Collections.Generic;
    using System.IO;
    #load "WindowsBase.dll"
    #load "PresentationCore.dll"
    #load "System.Numerics.dll"

    static bool IsConfigInitialised = false;
	static int SupremeM = 0;
	static int SupremeA = 0;
	static int ZevAura = 0;
	static long Addressbo6xxx = 0;
	static long Addressbo6110 = 0;
	static long Addressbo6120 = 0;
	static long Addressbo6140 = 0;
	static long Addressbo6160 = 0;
	static long Addressbo6165 = 0;
	static long Addressbo6180 = 0;
	static long Addressbo6190 = 0;
	static long AddressBlow00 = 0;
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;

	if (Addressbo6110 == 0) { /* 0x141466CF0 */ Addressbo6110 = ScanSignature ("bo6110", "xxxxxx"); }
	if (Addressbo6120 == 0) { /* 0x141466D20 */ Addressbo6120 = ScanSignature ("bo6120", "xxxxxx"); }
	if (Addressbo6140 == 0) { /* 0x141466D18 */ Addressbo6140 = ScanSignature ("bo6140", "xxxxxx"); }
	if (Addressbo6160 == 0) { /* 0x141466D00 */ Addressbo6160 = ScanSignature ("bo6160", "xxxxxx"); }
	if (Addressbo6165 == 0) { /* 0x141466D08 */ Addressbo6165 = ScanSignature ("bo6165", "xxxxxx"); }
	if (Addressbo6180 == 0) { /* 0x141466D28 */ Addressbo6180 = ScanSignature ("bo6180", "xxxxxx"); }
	if (Addressbo6190 == 0) { /* 0x141466CF8 */ Addressbo6190 = ScanSignature ("bo6190", "xxxxxx"); }
	if (AddressBlow00 == 0) { /* 0x141466728 */ AddressBlow00 = ScanSignature ("zev_blow_rifleboss", "xxxxxxxxxxxxxxxxxx"); }
	
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		SupremeM = INI.Parse<int>(ini["Main"]["RifleBeastYap"], SupremeM);
		SupremeA = INI.Parse<int>(ini["Main"]["RifleBeastAnm"], SupremeA);
		ZevAura = INI.Parse<int>(ini["Main"]["SS2_Aura"], ZevAura);
        IsConfigInitialised = true;
		
		if (ZevAura == 0)
		{ WriteProtected<byte>(Addressbo6180, System.Text.Encoding.UTF8.GetBytes("bo6180")); }
	
		if (ZevAura == 1)
		{ WriteProtected<byte>(Addressbo6180, System.Text.Encoding.UTF8.GetBytes("bo6181")); }
		
		if (SupremeM == 0) // Default Intro
		{ WriteProtected<byte>(Addressbo6110, System.Text.Encoding.UTF8.GetBytes("bo6110")); }
	
		if (SupremeM == 1) // Intro with Monologue
		{ WriteProtected<byte>(Addressbo6110, System.Text.Encoding.UTF8.GetBytes("bo6111")); }
	
		if ((SupremeA == 0) && (ZevAura == 0)) // Default
		{ WriteProtected<byte>(AddressBlow00, System.Text.Encoding.UTF8.GetBytes("zev_blow_rifleboss")); }
		
		if ((SupremeA == 0) && (ZevAura == 1)) // Blue Aura
		{ WriteProtected<byte>(AddressBlow00, System.Text.Encoding.UTF8.GetBytes("zev_blow_riflebs0B")); }
	
		if ((SupremeA == 1) && (ZevAura == 0)) // Edited Animation
		{ WriteProtected<byte>(AddressBlow00, System.Text.Encoding.UTF8.GetBytes("zev_blow_riflebs0E")); }
		
		if ((SupremeA == 1) && (ZevAura == 1)) // Edited Animation Blue Aura
		{ WriteProtected<byte>(AddressBlow00, System.Text.Encoding.UTF8.GetBytes("zev_blow_riflebs1B")); }
	
        if ((SupremeM == 0) && (SupremeA == 0) && (ZevAura == 0)) // bo61x0 - Default
        { 
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6120"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6140"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6160"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6165"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6190"));
		}
		if ((SupremeM == 0) && (SupremeA == 0) && (ZevAura == 1)) // bo61x1 - Default with Blue Aura
        { 
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6121"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6141"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6161"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6166"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6191"));
		}
        if ((SupremeM == 1) && (SupremeA == 0) && (ZevAura == 0)) // bo62x0 - Monologue Active
        {
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6220"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6240"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6260"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6265"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6290"));
			WriteProtected<byte>(AddressBlow00, System.Text.Encoding.UTF8.GetBytes("zev_blow_rifleboss"));
		}
		if ((SupremeM == 1) && (SupremeA == 0) && (ZevAura == 1)) // bo62x1 - Monologue with Blue Aura
        {
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6221"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6241"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6261"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6266"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6291"));
			WriteProtected<byte>(AddressBlow00, System.Text.Encoding.UTF8.GetBytes("zev_blow_riflebs01"));
		}
		if ((SupremeM == 0) && (SupremeA == 1) && (ZevAura == 0)) // bo63x0 - Edited Animation with Default Aura
        { 
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6320"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6340"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6360"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6365"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6390"));
		}
		if ((SupremeM == 0) && (SupremeA == 1) && (ZevAura == 1)) // bo63x1 - Edited Animation with Blue Aura
        { 
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6321"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6341"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6361"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6366"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6391"));
		}
        if ((SupremeM == 1) && (SupremeA == 1) && (ZevAura == 0)) // bo64x0 - Monologue with Edited Animation and Default Aura
        {
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6420"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6440"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6460"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6465"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6490"));
		}
		if ((SupremeM == 1) && (SupremeA == 1) && (ZevAura == 1)) // bo64x1 - Monologue with Edited Animation and Blue Aura
        {
			WriteProtected<byte>(Addressbo6120, System.Text.Encoding.UTF8.GetBytes("bo6421"));
			WriteProtected<byte>(Addressbo6140, System.Text.Encoding.UTF8.GetBytes("bo6441"));
			WriteProtected<byte>(Addressbo6160, System.Text.Encoding.UTF8.GetBytes("bo6461"));
			WriteProtected<byte>(Addressbo6165, System.Text.Encoding.UTF8.GetBytes("bo6466"));
			WriteProtected<byte>(Addressbo6190, System.Text.Encoding.UTF8.GetBytes("bo6491"));
		}
    }
}

Code "Darkball QTE" by "Hypernova"
//
	#include "Reflection" noemit
    #import "GOComponents"
    #import "PlayerVisuals"
	#import "Services"
	#import "Graphics"
	#import "Plugins"
    #lib "Reflection"
	#lib "HMM"
	#lib "INI"
	using System.Numerics;
    using System.Collections.Generic;
    using System.IO;
    #load "WindowsBase.dll"
    #load "PresentationCore.dll"
    #load "System.Numerics.dll"

    static bool IsConfigInitialised = false;
    static bool beastBallQTE = false;
	static int BossDarkballQTE = 0;

    static long AddressParryMs1 = 0;
	static long AddressGrandSp0 = 0;
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
	
	bool isRiflebeast = (GameManager.GetGameObject("RifleBeast0") != null);
	
	if (AddressParryMs1 == 0) { /* 0x141466710 */ AddressParryMs1 = ScanSignature ("zev_parrymiss_rifleboss", "xxxxxxxxxxxxxxxxxxxxxxx"); }
	if (AddressGrandSp0 == 0) { /* 0x1414636B8 */ AddressGrandSp0 = ScanSignature ("zev_sp_riflebeast", "xxxxxxxxxxxxxxxxx"); }
	
	bool isStart01 = evtPlayer->IsEventPlaying("bo6120");
	bool isStart02 = evtPlayer->IsEventPlaying("bo6121");
	bool isStart03 = evtPlayer->IsEventPlaying("bo6320");
	bool isStart04 = evtPlayer->IsEventPlaying("bo6321");
	
	bool isStartM1 = evtPlayer->IsEventPlaying("bo6220");
	bool isStartM2 = evtPlayer->IsEventPlaying("bo6221");
	bool isStartM3 = evtPlayer->IsEventPlaying("bo6420");
	bool isStartM4 = evtPlayer->IsEventPlaying("bo6421");
	
	bool isSecond1 = evtPlayer->IsEventPlaying("bo6140");
	bool isSecond2 = evtPlayer->IsEventPlaying("bo6141");
	bool isSecond3 = evtPlayer->IsEventPlaying("bo6340");
	bool isSecond4 = evtPlayer->IsEventPlaying("bo6341");
	
	bool isSndMno1 = evtPlayer->IsEventPlaying("bo6240");
	bool isSndMno2 = evtPlayer->IsEventPlaying("bo6241");
	bool isSndMno3 = evtPlayer->IsEventPlaying("bo6440");
	bool isSndMno4 = evtPlayer->IsEventPlaying("bo6441");
	
	if (isRiflebeast)
	{
		if ( (isStart01) || (isStart02) || (isStart03) || (isStart04) )
		{
			{ WriteProtected<byte>(AddressParryMs1, System.Text.Encoding.UTF8.GetBytes("zev_parrymiss_rifleboss")); }
			{ WriteProtected<byte>(AddressGrandSp0, System.Text.Encoding.UTF8.GetBytes("zev_sp_riflebst01")); }
		}
		if ( (isStartM1) || (isStartM2) || (isStartM3) || (isStartM4) )
		{
			{ WriteProtected<byte>(AddressParryMs1, System.Text.Encoding.UTF8.GetBytes("zev_parrymiss_riflebsB1")); }
			{ WriteProtected<byte>(AddressGrandSp0, System.Text.Encoding.UTF8.GetBytes("zev_sp_riflebstB1")); }
		}
		
		if ( (isSecond1) || (isSecond2) || (isSecond3) || (isSecond4) )
		{
			{ WriteProtected<byte>(AddressParryMs1, System.Text.Encoding.UTF8.GetBytes("zev_parrymiss_riflebs02")); }
			{ WriteProtected<byte>(AddressGrandSp0, System.Text.Encoding.UTF8.GetBytes("zev_sp_riflebst02")); }
		}
		if ( (isSndMno1) || (isSndMno2) || (isSndMno3) || (isSndMno4) )
		{
			{ WriteProtected<byte>(AddressParryMs1, System.Text.Encoding.UTF8.GetBytes("zev_parrymiss_riflebsB2")); }
			{ WriteProtected<byte>(AddressGrandSp0, System.Text.Encoding.UTF8.GetBytes("zev_sp_riflebstB2")); }
		}
	}

    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		BossDarkballQTE = INI.Parse<int>(ini["Main"]["BossBeastBall"], BossDarkballQTE);
        IsConfigInitialised = true;

        if (BossDarkballQTE == 1)
        { beastBallQTE = true; }
        else
        { beastBallQTE = false; }
    }
	
	if (!beastBallQTE)
		return;
	{
		bool isDarkball1 = evtPlayer->IsEventPlaying("bo6165");
		bool isDarkball2 = evtPlayer->IsEventPlaying("bo6265");
		bool isDarkball3 = evtPlayer->IsEventPlaying("bo6365");
		bool isDarkball4 = evtPlayer->IsEventPlaying("bo6465");
		
		bool isDarkblue1 = evtPlayer->IsEventPlaying("bo6166");
		bool isDarkblue2 = evtPlayer->IsEventPlaying("bo6266");
		bool isDarkblue3 = evtPlayer->IsEventPlaying("bo6366");
		bool isDarkblue4 = evtPlayer->IsEventPlaying("bo6466");
		
		if (isRiflebeast)
		{
			if ( (isDarkball1) || (isDarkball2) || (isDarkball3) || (isDarkball4) )
			{ WriteProtected<byte>(AddressParryMs1, System.Text.Encoding.UTF8.GetBytes("zev_parrymiss_riflebs03")); }
		
			if ( (isDarkblue1) || (isDarkblue2) || (isDarkblue3) || (isDarkblue4) )
			{ WriteProtected<byte>(AddressParryMs1, System.Text.Encoding.UTF8.GetBytes("zev_parrymiss_riflebsB3")); }
		}
	}
}

Library "EventPlayer" by "Ashrindy"
{
    #include "Helpers" noemit

    #lib "GameManager"
    #lib "Memory"
    #lib "GameService"
    #lib "Helpers"

    #import "Allocators"
    #import "Collections"

    #load "System.Numerics.dll"

    using System.Numerics;
    using System.Runtime.InteropServices;
    using System.Runtime.CompilerServices;

    FUNCTION_PTR(void, fpPlayEvent, 0x140139010, Data* self, EventSetupData* setupData)
    FUNCTION_PTR(void, fpSetupEventSetupData, 0x1401370C0, EventSetupData* self, Helpers.UnmanagedString cutsceneName)

    [StructLayout(LayoutKind.Explicit, Size = 0x160)]
    public struct EventSetupData {
        [Flags]
        public enum PlayFlag : uint {
            UseSetupTransform = 0x01,
            StopFadeOut = 0x02,
            CantSkip = 0x04,
            EnableHUD = 0x20,
            CappedFPS = 0x4000
        }

        [Flags]
        public enum PlayerFlag : uint {
            UsePosition = 0x01,
            UseRotation = 0x02
        }

        [FieldOffset(0)] public fixed byte cutsceneName[40];
        [FieldOffset(0x28)] public fixed byte soundName[40];
        [FieldOffset(0x50)] public Vector3 position;
        [FieldOffset(0x60)] public Quaternion rotation;
        [FieldOffset(0x70)] public Vector3 scale;
        [FieldOffset(0x84)] public float speed;
        [FieldOffset(0x88)] public PlayFlag playFlags;
        [FieldOffset(0x100)] public Vector3 playerPosition;
        [FieldOffset(0x110)] public Quaternion playerRotation;
        [FieldOffset(0x120)] public PlayerFlag playerFlags;

        public void Setup(string cutsceneName){
            fixed(EventSetupData* pThis = &this){
                GET_FUNCTION_PTR(fpSetupEventSetupData)(pThis, new Helpers.UnmanagedString(cutsceneName));
            }
        }

        public EventSetupData(){}

        public EventSetupData(string cutsceneName){
            Setup(cutsceneName);
        }
    }

    [StructLayout(LayoutKind.Explicit, Size = 0x10)]
    public struct VariableString {
        [FieldOffset(0)] public Helpers.UnmanagedString buffer;
        [FieldOffset(0x8)] public long allocator;
    }

    [StructLayout(LayoutKind.Explicit, Size = 0x58)]
    public struct EventSceneManager {
        [FieldOffset(0x38)] public ObjectMoveArray<VariableString> eventNames;

        public bool IsEventPlaying(string name) {
            foreach(var x in eventNames) {
                if(x.buffer.Value == name){
                    return true;
                }
            }
            return false;
        }
    }

    [StructLayout(LayoutKind.Explicit, Size = 0x160)]
    public struct Data {
        [FieldOffset(0x130)] public Memory.Pointer<EventSceneManager> evtSceneMgr;

        public void PlayEvent(ref EventSetupData setupData){
            fixed(EventSetupData* pSetupData = &setupData)
            fixed(Data* pThis = &this){
                GET_FUNCTION_PTR(fpPlayEvent)(pThis, pSetupData);
            }
        }

        public bool IsEventPlaying(string name){
            if(evtSceneMgr.Get() != null)
                return evtSceneMgr.Get()->IsEventPlaying(name);
            return false;
        }
    }
}