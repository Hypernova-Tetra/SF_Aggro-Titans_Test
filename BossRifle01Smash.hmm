Code "Supreme Unused Grand Slam EventPlayer and No ShieldTackle" by "Batman Sonic, Hypernova, Holoska, Ashrindy, and thej01"
//
	using System.Numerics;
    using System.Collections.Generic;
    using System.IO;
	using System.Windows.Input;
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	
	#include "Reflection" noemit
	
	#lib "Reflection"
	#lib "BlackboardItem"
	#lib "BlackboardStatus"
    #lib "HMM"
	#lib "INI"
	#lib "Player"
	#lib "Sonic"
	#lib "SonicParameters"
    #lib "Lua"
	#lib "XInput"
    #lib "EventPlayer"
    #lib "Memory"
    #lib "Helpers"
    #lib "GameService"
	#lib "GameObject"
	#lib "GameManager"
	
    #load "WindowsBase.dll"
    #load "PresentationCore.dll"
    #load "System.Numerics.dll"
	
	static int BossHP = 0;
	static int BossRifleSp00 = 0;
	static long AddressSplDmg = 0;
	static long AdObjGa3220 = 0;
	
    static bool healthBool = false;
	static bool smashBool = false;
	static bool initialized = false;
	static bool IsConfigInitialised = false;
	
	static int ReplaceNum = 0;
    static BossRifleBeastConfig.AtackType[] AttackReplacers = new BossRifleBeastConfig.AtackType[2];
    AttackReplacers[0] = BossRifleBeastConfig.AtackType.AT_CROW_L;
    AttackReplacers[1] = BossRifleBeastConfig.AtackType.AT_CROW_R;
    var RifleBeastInfo = Reflection.GetDataInfo<BossRifleBeastConfig.Root>("boss_rifle_beast");	
//
{
	var pBlackboardStatus = BlackboardStatus.Get();
	if (Player.GetPlayerType() != Player.PlayerType.Sonic)
		return;

	var pBlackboardItem = BlackboardItem.Get();
	if (pBlackboardItem == null)
		return;
	
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;

	if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");

		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		BossRifleSp00 = INI.Parse<int>(ini["Main"]["BossZevRifleSp00"], BossRifleSp00);
        IsConfigInitialised = true;
		if (BossRifleSp00 == 1)
        {smashBool = true;}
        else
        {smashBool = false;}
		
		BossHP = INI.Parse<int>(ini["Main"]["BossCombat"], BossHP);
        IsConfigInitialised = true;
		if (BossHP == 1)
        {healthBool = true;}
        else
        {healthBool = false;}
    }

	if (!smashBool)
		return;
	{	
		if (AdObjGa3220 == 0) { /* 0x141556068 */ AdObjGa3220 = ScanSignature ("obj_event_ga3220", "xxxxxxxxxxxxxxxx"); }
		if (AddressSplDmg == 0) { /* 0x14140F5D0 */ AddressSplDmg = ScanSignature ("special_atk_damage", "xxxxxxxxxxxxxxxxxx"); }
		
		bool isGiantBoss04 = (Player.State.GetStatePlugin("StatePluginBossBattle") != null) && (GameManager.GetGameObject("Rifle0") != null) && BlackboardStatus.IsSuper();
		if (isGiantBoss04)
		{
			bool isStrt04 = evtPlayer->IsEventPlaying("bo4110")
			bool isStrt06 = evtPlayer->IsEventPlaying("bo4111")
			if ((isStrt04) || (isStrt06)) // Phase 1
			{ 
				AdObjGa3220 = 1
				WriteProtected<byte>(AdObjGa3220, System.Text.Encoding.UTF8.GetBytes("zev_rfl_grndsp01"));
			}
			
			bool isPhz204 = evtPlayer->IsEventPlaying("bo4142")
			bool isPhz206 = evtPlayer->IsEventPlaying("bo4140")
			if ((isPhz204) || (isPhz206)) // Phase 2
			{
				AdObjGa3220 = 2
				WriteProtected<byte>(AdObjGa3220, System.Text.Encoding.UTF8.GetBytes("zev_rfl_grndsp02"));
			}
			
			bool isFinZ04 = evtPlayer->IsEventPlaying("bo4160")
			bool isFinZ06 = evtPlayer->IsEventPlaying("bo4162")
			if ((isFinZ04) || (isFinZ06)) // End
			{ 
				AdObjGa3220 = 0
				WriteProtected<byte>(AdObjGa3220, System.Text.Encoding.UTF8.GetBytes("obj_event_ga3220"));
			}
			
			int maxrings = pBlackboardItem->RingCapacity;
			int rings = pBlackboardItem->RingCount;

			if(rings > maxrings)
			{pBlackboardItem->RingCount = maxrings;}

			if(rings < 0)
			{pBlackboardItem->RingCount = 0;}
	
			WriteProtected<byte>(AddressSplDmg, System.Text.Encoding.UTF8.GetBytes("special_atk_cyloop"));
				
			if ((XInput.IsButtonDown(XInput.Buttons.Y) && XInput.IsButtonDown(XInput.Buttons.B)) && (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSmashSS))
			{				
				if (AdObjGa3220 == 1)
				{
					var setupData = new EventPlayer.EventSetupData("zev_rfl_grndsp01");
					setupData.playFlags &= (EventPlayer.EventSetupData.PlayFlag)0xFFFFFFFB; //CantSkip//
					evtPlayer->PlayEvent(ref setupData);
				}
				if (AdObjGa3220 == 2)
				{					
					var setupData = new EventPlayer.EventSetupData("zev_rfl_grndsp02");
					setupData.playFlags &= (EventPlayer.EventSetupData.PlayFlag)0xFFFFFFFB; //CantSkip//
					evtPlayer->PlayEvent(ref setupData);
				}
				
				var BossRifleBeastConfigInfo = Reflection.GetDataInfo<BossRifleBeastConfig.Root>("boss_rifle_beast");
				if (BossRifleBeastConfigInfo.pData == null)
					return;

				for (int i = 0; i < 12; ++i)
				{
					for (int j = 0; j < 10; ++j)
					{
						if ((RFL_GET_PARAM(RifleBeastInfo, battleParam.attackPatternAfter[i].attackPattern[j])) == BossRifleBeastConfig.AtackType.AT_TACKLE)
						{
							RFL_SET_PARAM(RifleBeastInfo, battleParam.attackPatternAfter[i].attackPattern[j], AttackReplacers[ReplaceNum]);
							++ReplaceNum;
							if (ReplaceNum > 1)
								ReplaceNum = 0;
						}
					}
				}
			}
			
			bool eventGrandS1 = evtPlayer->IsEventPlaying("zev_rfl_grndsp01")
			bool eventGrandS2 = evtPlayer->IsEventPlaying("zev_rfl_grndsp02")
			if ((eventGrandS1) || (eventGrandS2))
			{ WriteProtected<byte>(AddressSplDmg, System.Text.Encoding.UTF8.GetBytes("zev_rfl_grandsmash")); }
			else 
			{ WriteProtected<byte>(AddressSplDmg, System.Text.Encoding.UTF8.GetBytes("special_atk_cyloop")); }
		}
		else 
		{ WriteProtected<byte>(AddressSplDmg, System.Text.Encoding.UTF8.GetBytes("special_atk_damage")); }
	}

	if (!healthBool && !smashBool)
		return;
	{
		bool isGiantBoss04 = (Player.State.GetStatePlugin("StatePluginBossBattle") != null) && (GameManager.GetGameObject("Rifle0") != null) && BlackboardStatus.IsSuper();
		if (!isGiantBoss04)
			return;
		{
			int maxrings = pBlackboardItem->RingCapacity;
			int rings = pBlackboardItem->RingCount;
			
			if ((XInput.IsButtonDown(XInput.Buttons.Y) && XInput.IsButtonDown(XInput.Buttons.B)) && (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSmashSS))
			{
				pBlackboardItem->RingCount += 10;
				
				if(rings > maxrings)
				pBlackboardItem->RingCount = maxrings;
				
				if(rings < 0)
				pBlackboardItem->RingCount = 0;
			}
		}
	}
}