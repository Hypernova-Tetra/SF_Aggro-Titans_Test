Code "Skippable Cutscenes Giganto" by "Hypernova"
//
	#include "Reflection" noemit
	#lib "GameManager"
	#lib "EventPlayer"
	#lib "GameObject"
	#lib "BlackboardStatus"
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
	#lib "Lua"
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	
	static long BO1120 = 0;
	static long BO1160 = 0;
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
	
	string currentStage = LevelInfo.GetCurrentStageID();
	
	bool isKronosOpenZ = (LevelInfo.GetCurrentStageID() == "w1r03");
	bool isKronosBttle = (LevelInfo.GetCurrentStageID() == "w1b01");
	bool isKronosTrial = (LevelInfo.GetCurrentStageID() == "w1t01");
	bool isGigantoActiveSkipF2 = evtPlayer->IsEventPlaying("bo1141");
	
	WriteProtected<byte>
	( /* 0x1414534F0 */ ScanSignature ("boss_giant01_bo1140","xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("bo1140\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"));
	
	WriteProtected<byte>
	( /* 0x1414534E4 */ ScanSignature ("bo1140", "xxxxxx"), System.Text.Encoding.UTF8.GetBytes("bo1141"));
	
	if (BO1120 == 0) { /* 0x1414534C8 */ BO1120 = ScanSignature ("bo1120", "xxxxxx"); }
	if (BO1160 == 0) { /* 0x141453520 */ BO1160 = ScanSignature ("bo1160", "xxxxxx"); }
	
	if (isKronosOpenZ)
	{
		WriteProtected<byte>(BO1120, System.Text.Encoding.UTF8.GetBytes("bo1122"));
		WriteProtected<byte>(BO1160, System.Text.Encoding.UTF8.GetBytes("bo1160")); 
	}
	
	if (isKronosBttle)
	{
		WriteProtected<byte>(BO1120, System.Text.Encoding.UTF8.GetBytes("bo1120"));
		WriteProtected<byte>(BO1160, System.Text.Encoding.UTF8.GetBytes("bo1151"));
	}
	
	if (isKronosTrial)
	{
		WriteProtected<byte>(BO1120, System.Text.Encoding.UTF8.GetBytes("bo1121")); 
		WriteProtected<byte>(BO1160, System.Text.Encoding.UTF8.GetBytes("bo1161")); 
	}
	
	if (isGigantoActiveSkipF2)
	{
		if ((isKronosOpenZ) || (isKronosBttle))
		{
			var setupData = new EventPlayer.EventSetupData("bo1140");
			evtPlayer->PlayEvent(ref setupData);
		}
		
		if (isKronosTrial)
		{
			var setupData = new EventPlayer.EventSetupData("bo1142");
			evtPlayer->PlayEvent(ref setupData);
		}
	}
}

Code "Giganto Dynamics" by "Hypernova"
//
	#lib "GameManager"
	#lib "GameObject"
	#lib "EventPlayer"
	#lib "Reflection"
	#lib "Player"
	#lib "Sonic"
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	#include "Reflection" noemit
	
	static long AdCyloopAtk = 0;
	static long AdCyloopPry = 0;
	static long AdAtkCnSp02 = 0;
	static long Address1180 = 0;
	static long AttackShout = 0;
//
{	
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
	
	var pBlackboardStatus = BlackboardStatus.Get();
	if (Player.GetPlayerType() != Player.PlayerType.Sonic)
		return;
	
	bool isGiantF1 = evtPlayer->IsEventPlaying("bo1120");
	bool isGiantT1 = evtPlayer->IsEventPlaying("bo1121");
	bool isGiantF2 = evtPlayer->IsEventPlaying("bo1140");
	bool isGiantT2 = evtPlayer->IsEventPlaying("bo1142");
	bool isGntWin2 = evtPlayer->IsEventPlaying("bo1151");
	bool isGntWin1 = evtPlayer->IsEventPlaying("bo1160");
	bool isGntWin3 = evtPlayer->IsEventPlaying("bo1170");
	bool isGiganto = (GameManager.GetGameObject("Giant0") != null);
	bool SuperBattle = IS_WORLD_FLAG(IsBattle) && BlackboardStatus.IsSuper();
	
	if ((isGiganto) && (SuperBattle))
	{		
		if (AttackShout == 0)
		{ /* 0x1414508E8 */ AttackShout = ScanSignature ("attack_howl", "xxxxxxxxxxx"); }
	
		if (AdCyloopAtk == 0)
		{ /* 0x14140F690 */ AdCyloopAtk = ScanSignature ("cyloop_counter", "xxxxxxxxxxxxxx"); }
	
		if (AdCyloopPry == 0)
		{ /* 0x14140F6A0 */ AdCyloopPry = ScanSignature ("cyloop_counter_parry", "xxxxxxxxxxxxxxxxxxxx"); }
	
		if (AdAtkCnSp02 == 0)
		{ /* 0x141451370 */ AdAtkCnSp02 = ScanSignature ("attack_counter_sp_02", "xxxxxxxxxxxxxxxxxxxx"); }
	
		if (Address1180 == 0)
		{/* 0x141453544 */ Address1180 = ScanSignature ("bo1180", "xxxxxx");}
			
		if ((isGiantF1) || (isGiantT1) || (isGntWin1) || (isGntWin2) || (isGntWin3))
		{ 
			WriteProtected<byte>(AttackShout, System.Text.Encoding.UTF8.GetBytes("attack_howl"));
			WriteProtected<byte>(AdCyloopAtk, System.Text.Encoding.UTF8.GetBytes("cyloop_counter"));
			WriteProtected<byte>(AdCyloopPry, System.Text.Encoding.UTF8.GetBytes("cyloop_counter_parry"));
			WriteProtected<byte>(AdAtkCnSp02, System.Text.Encoding.UTF8.GetBytes("attack_counter_sp_02"));
			WriteProtected<byte>(Address1180, System.Text.Encoding.UTF8.GetBytes("bo1180"));
		}
		
		if ((isGiantF2) || (isGiantT2))
		{ 
			WriteProtected<byte>(AttackShout, System.Text.Encoding.UTF8.GetBytes("attack_howl"));
			WriteProtected<byte>(AdCyloopAtk, System.Text.Encoding.UTF8.GetBytes("cyloop_attck_r"));
			WriteProtected<byte>(AdCyloopPry, System.Text.Encoding.UTF8.GetBytes("cyloop_counter_pry_r"));
			WriteProtected<byte>(Address1180, System.Text.Encoding.UTF8.GetBytes("bo1181"));
		}
		
		if (isGiantT2)
		{ 
			WriteProtected<byte>(AdAtkCnSp02, System.Text.Encoding.UTF8.GetBytes("attack_counter_sp_03"));
		}
	}
}

Code "Giganto Finale Beta"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
    #import "Services"
    static bool IsConfigInitialised = false;
    static bool scene1Bool = false;
	static int BossGiantFinale = 0;
//
{
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		BossGiantFinale = INI.Parse<int>(ini["Main"]["BossGiant1160"], BossGiantFinale);
        IsConfigInitialised = true;
		
		if (BossGiantFinale == 1)
        { WriteProtected<byte> ( /* 0x141453520 */ ScanSignature ( "bo1160", "xxxxxx" ), System.Text.Encoding.UTF8.GetBytes("bo1170") ); }
        else
        { scene1Bool = false; }
    }
}

Library "EventPlayer" by "Ashrindy"
{
    #include "Helpers" noemit

    #lib "GameManager"
    #lib "Memory"
    #lib "GameService"
    #lib "Helpers"

    #import "Allocators"
    #import "Collections"

    #load "System.Numerics.dll"

    using System.Numerics;
    using System.Runtime.InteropServices;
    using System.Runtime.CompilerServices;

    FUNCTION_PTR(void, fpPlayEvent, 0x140139010, Data* self, EventSetupData* setupData)
    FUNCTION_PTR(void, fpSetupEventSetupData, 0x1401370C0, EventSetupData* self, Helpers.UnmanagedString cutsceneName)

    [StructLayout(LayoutKind.Explicit, Size = 0x160)]
    public struct EventSetupData {
        [Flags]
        public enum PlayFlag : uint {
            UseSetupTransform = 0x01,
            StopFadeOut = 0x02,
            CantSkip = 0x04,
            EnableHUD = 0x20,
            CappedFPS = 0x4000
        }

        [Flags]
        public enum PlayerFlag : uint {
            UsePosition = 0x01,
            UseRotation = 0x02
        }

        [FieldOffset(0)] public fixed byte cutsceneName[40];
        [FieldOffset(0x28)] public fixed byte soundName[40];
        [FieldOffset(0x50)] public Vector3 position;
        [FieldOffset(0x60)] public Quaternion rotation;
        [FieldOffset(0x70)] public Vector3 scale;
        [FieldOffset(0x84)] public float speed;
        [FieldOffset(0x88)] public PlayFlag playFlags;
        [FieldOffset(0x100)] public Vector3 playerPosition;
        [FieldOffset(0x110)] public Quaternion playerRotation;
        [FieldOffset(0x120)] public PlayerFlag playerFlags;

        public void Setup(string cutsceneName){
            fixed(EventSetupData* pThis = &this){
                GET_FUNCTION_PTR(fpSetupEventSetupData)(pThis, new Helpers.UnmanagedString(cutsceneName));
            }
        }

        public EventSetupData(){}

        public EventSetupData(string cutsceneName){
            Setup(cutsceneName);
        }
    }

    [StructLayout(LayoutKind.Explicit, Size = 0x10)]
    public struct VariableString {
        [FieldOffset(0)] public Helpers.UnmanagedString buffer;
        [FieldOffset(0x8)] public long allocator;
    }

    [StructLayout(LayoutKind.Explicit, Size = 0x58)]
    public struct EventSceneManager {
        [FieldOffset(0x38)] public ObjectMoveArray<VariableString> eventNames;

        public bool IsEventPlaying(string name) {
            foreach(var x in eventNames) {
                if(x.buffer.Value == name){
                    return true;
                }
            }
            return false;
        }
    }

    [StructLayout(LayoutKind.Explicit, Size = 0x160)]
    public struct Data {
        [FieldOffset(0x130)] public Memory.Pointer<EventSceneManager> evtSceneMgr;

        public void PlayEvent(ref EventSetupData setupData){
            fixed(EventSetupData* pSetupData = &setupData)
            fixed(Data* pThis = &this){
                GET_FUNCTION_PTR(fpPlayEvent)(pThis, pSetupData);
            }
        }

        public bool IsEventPlaying(string name){
            if(evtSceneMgr.Get() != null)
                return evtSceneMgr.Get()->IsEventPlaying(name);
            return false;
        }
    }
}