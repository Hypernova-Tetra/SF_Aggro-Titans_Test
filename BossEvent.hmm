	static bool IsConfigInitialised = false;
    static long Address1140 = 0;
	static long Address2140 = 0;
	static long Address3140 = 0;
	static long Address4140 = 0;
	static int BossPhase2 = 0;
	static bool PhaseBool = false;
//
{
	string currentStage = LevelInfo.GetCurrentStageID();
	
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		BossPhase2 = INI.Parse<int>(ini["Main"]["BossX40"], BossPhase2);
        IsConfigInitialised = true;

        if (BossPhase2 == 1)
		{PhaseBool = true;}
		
        else
        {
			PhaseBool = false;
			
			WriteProtected<byte>
			( /* 0x141534F0 */ ScanSignature ("boss_giant01_bo1140","xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("update_event_signal"));
			WriteProtected<byte>
			( /* 0x14144C988 */ ScanSignature ("boss_giant02_bo2140", "xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("update_event_signal"));
			WriteProtected<byte>
			( /* 0x14145C238 */ ScanSignature ("boss_giant03_bo3140", "xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("update_event_signal"));
			WriteProtected<byte>
			( /* 0x14145C108 */ ScanSignature ("boss_giant03_bo3120", "xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("update_event_signal"));
		}
    }
	
	if (!PhaseBool)
		return;
	
	WriteProtected<byte>
	( /* 0x141534F0 */ ScanSignature ("boss_giant01_bo1140","xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("bo1140\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"));

	if (Address1140 == 0)
	{ /* 0x1414534E4 */ Address1140 = ScanSignature ("bo1140", "xxxxxx"); }

	if ((LevelInfo.GetCurrentStageID() == "w1r03") || (LevelInfo.GetCurrentStageID() == "w1r06"))
	{ WriteProtected<byte>(Address1140, System.Text.Encoding.UTF8.GetBytes("bo1140")); }
	
	if ((LevelInfo.GetCurrentStageID() == "w1b01") || (LevelInfo.GetCurrentStageID() == "w1t01"))
	{ WriteProtected<byte>(Address1140, System.Text.Encoding.UTF8.GetBytes("bo1141")); }

	bool eventGiantRushTrial = Lua.Call<int>("IsPlayingDiEvent", "bo1141") == 1;
	if (eventGiantRushTrial)
	{
		var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
		var setupData = new EventPlayer.EventSetupData("bo1140");
		evtPlayer->PlayEvent(ref setupData);
	}

	WriteProtected<byte>
	( /* 0x14144C988 */ ScanSignature ("boss_giant02_bo2140", "xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("bo2140\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"));

	if (Address2140 == 0)
	{ /* 0x14144C97C */ Address2140 = ScanSignature ("bo2140", "xxxxxx");}

	if ((LevelInfo.GetCurrentStageID() == "w2r01") || (LevelInfo.GetCurrentStageID() == "w2b01") || (LevelInfo.GetCurrentStageID() == "w2t01"))
	{ WriteProtected<byte>(Address2140, System.Text.Encoding.UTF8.GetBytes("bo2141")); }
	else
	{ WriteProtected<byte>(Address2140, System.Text.Encoding.UTF8.GetBytes("bo2140")); }

	if (LevelInfo.GetCurrentStageID() == "w2r01")
	{
		bool eventDragonPhase2 = Lua.Call<int>("IsPlayingDiEvent", "bo2141") == 1;
		if (eventDragonPhase2)
		{ Lua.Call("PlayDiEventFrozen", "bo2140"); }
	}

	if ((LevelInfo.GetCurrentStageID() == "w2b01") || (LevelInfo.GetCurrentStageID() == "w2t01"))
	{
		bool eventDragonRushTrial = Lua.Call<int>("IsPlayingDiEvent", "bo2141") == 1;
		if (eventDragonRushTrial)
		{
			var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
			var setupData = new EventPlayer.EventSetupData("bo2140");
			evtPlayer->PlayEvent(ref setupData);
		}
	}

	WriteProtected<byte>
	( /* 0x14145C238 */ ScanSignature ("boss_giant03_bo3140", "xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("bo3140\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"));
	
	WriteProtected<byte>
	( /* 0x14145C108 */ ScanSignature ("boss_giant03_bo3120", "xxxxxxxxxxxxxxxxxxx"), System.Text.Encoding.UTF8.GetBytes("bo3145\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"));
	
	if (Address3140 == 0)
	{ /* 0x14145C230 */ Address3140 = ScanSignature ("bo3140", "xxxxxx"); }
	
	if ((LevelInfo.GetCurrentStageID() == "w3r01") || (LevelInfo.GetCurrentStageID() == "w3b01") || (LevelInfo.GetCurrentStageID() == "w3t01"))
	{ WriteProtected<byte>(Address3140, System.Text.Encoding.UTF8.GetBytes("bo3141")); }
	
	if ((LevelInfo.GetCurrentStageID() == "w3r01") || (LevelInfo.GetCurrentStageID() == "w3b01"))
	{	
		bool eventKnightPhase2 = Lua.Call<int>("IsPlayingDiEvent", "bo3141") == 1;
		if (eventKnightPhase2)
		{
			var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
			var setupData = new EventPlayer.EventSetupData("bo3140");
			evtPlayer->PlayEvent(ref setupData);
		}
	}
	
	if (LevelInfo.GetCurrentStageID() == "w3t01")
	{	
		bool eventKnightMKT = Lua.Call<int>("IsPlayingDiEvent", "bo3141") == 1;
		if (eventKnightMKT)
		{
			var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
			var setupData = new EventPlayer.EventSetupData("bo3145");
			evtPlayer->PlayEvent(ref setupData);
		}
		
		bool eventQTEKnight2 = Lua.Call<int>("IsPlayingDiEvent", "bo3145") == 1;
		if (eventQTEKnight2)
		{	
			var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
			var setupData = new EventPlayer.EventSetupData("zev_knight_shieldride02_aerial");
			setupData.playFlags &= (EventPlayer.EventSetupData.PlayFlag)0xFFFFFFFB; //CantSkip//
			evtPlayer->PlayEvent(ref setupData);
		}
	}
	
	if (Address4140 == 0)
	{ /* 0x1414534E4 */ Address4140 = ScanSignature ("bo4140", "xxxxxx");}
	
	if ((LevelInfo.GetCurrentStageID() == "w1r04") || (LevelInfo.GetCurrentStageID() == "w1b02") || (LevelInfo.GetCurrentStageID() == "w1r06"))
	{ WriteProtected<byte>(Address4140, System.Text.Encoding.UTF8.GetBytes("bo4141")); }
	else
	{ WriteProtected<byte>(Address4140, System.Text.Encoding.UTF8.GetBytes("bo4140")); }
	
	if ((LevelInfo.GetCurrentStageID() == "w1r04") || (LevelInfo.GetCurrentStageID() == "w1b02") || (LevelInfo.GetCurrentStageID() == "w1r06"))
	{
		bool eventRiflePhase2 = Lua.Call<int>("IsPlayingDiEvent", "bo4141") == 1;
		if (eventRiflePhase2)
		{
			var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
			var setupData = new EventPlayer.EventSetupData("bo4140");
			evtPlayer->PlayEvent(ref setupData);
