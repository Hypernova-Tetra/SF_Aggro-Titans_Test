Code "Skippable Cutscenes Supreme" by "Hypernova"
//
	#include "Reflection" noemit
	#lib "GameManager"
	#lib "EventPlayer"
	#lib "GameObject"
	#lib "BlackboardStatus"
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
	#lib "Lua"
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;

	if (Lua.Call<int>("IsPlayingDiEventAll") == 1)
	{
		if (Lua.Call<int>("IsPlayingDiEvent", "bo4141") == 1)
		{
			var setupData = new EventPlayer.EventSetupData("bo4140");
			evtPlayer->PlayEvent(ref setupData);
		}
	}
}

Code "Ouranos Pyramid Beam No-More" by "Hypernova"
//
	#import "Services"
	#import "Plugins"
	#include "Reflection" noemit
	#lib "Reflection"
	#lib "BlackboardStatus"
    #lib "HMM"
	#lib "INI"
	#lib "Lua"
//
{	
	if (Lua.GetState() == 0)
    return;

	if (Lua.Call<int>("IsPlayingDiEvent", "ev5020") == 1)
	{ Lua.Call("SetLayerEnabled", "w1r04_plan_common", false); }
}

Patch "Supreme Intro"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
    #import "Services"
    static bool IsConfigInitialised = false;
    static bool RifleStartBool = false;
	static int RifleStart = 0;
//
{
    if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		if (mod == null)
			return;

		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);

		RifleStart = INI.Parse<int>(ini["Main"]["BossRifleStart"], RifleStart);
        IsConfigInitialised = true;

        if (RifleStart == 1)
        { RifleStartBool = true; }
        else
        { RifleStartBool = false; }
    }
	
	if (!RifleStartBool)
		return;
	{ WriteProtected<byte> ( /* 0x1414624B0 */ ScanSignature ( "bo4110", "xxxxxx" ), System.Text.Encoding.UTF8.GetBytes("bo411X")); }
}

